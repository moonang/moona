# Copy to .env.local (and add the same values in Netlify > Site settings > Environment variables).
# Leave these empty to run Moona in demo mode with sample events.

# Supabase > Project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=     # sb_publishable_...  (Settings > API Keys) — safe to be public
# Secret. Server only. Never paste this anywhere public.
SUPABASE_SECRET_KEY=                      # sb_secret_...  SECRET: server only, never commit, never paste in chat

# The public address of the site
NEXT_PUBLIC_SITE_URL=https://moona.ng

# Monnify (added when payments go live)
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_BASE_URL=https://sandbox.monnify.com

# Email confirmations (Resend). Verify moona.ng in Resend first (it gives you DNS records to add at your domain registrar).
RESEND_API_KEY=                           # re_...  SECRET: server only, never commit, never paste in chat
EMAIL_FROM="Moona <hello@moona.ng>"
